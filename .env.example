# ─── Base de données (Supabase) ────────────────────────────────
# Tableau de bord Supabase → Connect → ORMs → Prisma.
# DATABASE_URL : pooler en mode transaction (port 6543), utilisé par l'application et le seed (TLS géré par src/lib/db-ssl.ts : pas de sslmode ici).
DATABASE_URL="postgresql://postgres.<ref>:<mot-de-passe>@aws-1-<région>.pooler.supabase.com:6543/postgres"
# DIRECT_URL : pooler en mode session (port 5432) ou connexion directe, utilisé par la CLI Prisma (migrations, studio).
DIRECT_URL="postgresql://postgres.<ref>:<mot-de-passe>@aws-1-<région>.pooler.supabase.com:5432/postgres?sslmode=require"
# Facultatif : certificat racine Supabase (Project Settings → Database → SSL) pour vérifier l'identité du serveur.
# DATABASE_SSL_CA="./certs/supabase-prod-ca-2021.crt"
# Tout autre PostgreSQL 15+ fonctionne aussi (local, Neon, Railway…) : une seule URL suffit alors.
# DATABASE_URL="postgresql://postgres:motdepasse@localhost:5432/nadi?schema=public"

# ─── Application ───────────────────────────────────────────────
# URL publique (utilisée dans les SMS et les liens partagés)
APP_URL="https://www.nadigroup.sn"
# Secret de signature des sessions : générer avec `openssl rand -hex 32`
SESSION_SECRET=""
# Pays par défaut des numéros saisis sans indicatif (SN = Sénégal)
DEFAULT_COUNTRY="SN"

# ─── SMS (codes de connexion, confirmations, rappels) ──────────
# console = affichage dans les logs (développement uniquement)
SMS_PROVIDER="console"          # console | orange | twilio
SMS_SENDER_NAME="NADI Group"

# Orange SMS API (https://developer.orange.com/apis/sms)
ORANGE_CLIENT_ID=""
ORANGE_CLIENT_SECRET=""
ORANGE_SENDER_ADDRESS=""        # ex. +221770000000 (numéro fourni par Orange)
ORANGE_SENDER_NAME=""           # optionnel : nom d'expéditeur validé par Orange

# Twilio (https://www.twilio.com)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""                  # numéro Twilio ou identifiant alphanumérique

# ─── Stockage des fichiers (photos, vidéos, documents) ─────────
STORAGE_DRIVER="supabase"       # local | supabase | s3
STORAGE_LOCAL_DIR="./storage"   # dossier persistant si STORAGE_DRIVER=local

# Supabase Storage (tableau de bord → Project Settings → API) : bucket privé, clé service_role côté serveur uniquement
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="nadi"

# Compatible S3 (STORAGE_DRIVER=s3) : Amazon S3, Cloudflare R2, MinIO…
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""                  # vide pour Amazon S3
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# ─── Rappels automatiques ──────────────────────────────────────
# Appeler chaque jour : GET /api/cron/reminders avec l'en-tête
# « Authorization: Bearer <CRON_SECRET> »
CRON_SECRET=""

# ─── Données de démonstration (npm run db:seed) ────────────────
SEED_ADMIN_EMAIL="admin@nadigroup.sn"
SEED_ADMIN_PASSWORD="ChangezMoi2026!"
