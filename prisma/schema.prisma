// Schéma de données — FUTURIA GROUP (gestion de lotissement)
// Les montants sont stockés en unités entières de la devise (FCFA, sans centimes).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Administration
// ─────────────────────────────────────────────────────────────

enum AdminRole {
  OWNER // responsable : accès complet, gestion des utilisateurs
  ADMIN // gestion complète sauf utilisateurs
  VIEWER // lecture seule (comptable, associé…)
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  phone        String?
  passwordHash String
  role         AdminRole @default(ADMIN)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  payments             Payment[]
  activities           Activity[]
  constructionPayments ConstructionPayment[]
  expenses             Expense[]
}

// Paramètres globaux (ligne unique, id = 1)
model Settings {
  id Int @id @default(1)

  // Entreprise
  companyName     String  @default("FUTURIA GROUP")
  companyTagline  String  @default("Bâtir aujourd'hui les quartiers de demain")
  companyAbout    String  @default("")
  companyPhone    String  @default("")
  companyWhatsapp String  @default("")
  companyEmail    String  @default("")
  companyAddress  String  @default("")
  logoUrl         String?
  signatureKey    String? // cachet + signature des reçus : clé du stockage privé, servie par /api/signature

  // Site / lotissement
  siteName        String @default("Domaine FUTURIA")
  siteLocation    String @default("")
  siteDescription String @default("")
  siteAreaM2      Float  @default(40000)
  siteLatitude    Float?
  siteLongitude   Float?
  amenities       Json   @default("[]") // string[]
  highlights      Json   @default("[]") // { title, text }[]
  faq             Json   @default("[]") // { q, a }[]

  // Page d'accueil
  heroEyebrow     String  @default("")
  heroTitle       String  @default("")
  heroSubtitle    String  @default("")
  heroImageUrl    String?
  processImageUrl String?
  contactImageUrl String?
  aboutVideoUrl   String? // lien YouTube / Vimeo (section « Pourquoi choisir »)
  lotImages       Json    @default("[]") // string[] : photos illustrant les cartes de terrains
  businessHours   String  @default("")
  socialFacebook  String?
  socialInstagram String?
  socialLinkedin  String?
  socialYoutube   String?
  legalNotice     String  @default("")
  privacyPolicy   String  @default("")

  // Plan interactif
  planImageUrl String?
  planWidth    Int     @default(1600)
  planHeight   Int     @default(1000)

  // Commercial
  // Prix du m² du site : les terrains sans prix particulier (Lot.customPrice) suivent prix = surface × prix du m²,
  // arrondi à lotPriceRounding. null = prix saisis terrain par terrain. Calculs : @/lib/lot-pricing.
  lotPricePerM2       Float?
  lotPriceRounding    Int              @default(1000)
  currencyLabel       String           @default("FCFA")
  showPricesPublicly  Boolean          @default(true)
  defaultDepositRate  Float            @default(30) // % du prix
  defaultInstallments Int              @default(12)
  defaultFrequency    PaymentFrequency @default(MONTHLY)
  reservationsOpen    Boolean          @default(true)

  // Notifications SMS
  alertPhone            String? // reçoit une alerte à chaque nouvelle demande
  smsOnPayment          Boolean @default(true)
  smsReminderDaysBefore Int     @default(3)
  smsOverdueReminders   Boolean @default(true)

  updatedAt DateTime @updatedAt
}

// Champs personnalisés définis par le responsable pour décrire les terrains
enum FieldType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
}

model LotField {
  id         String    @id @default(cuid())
  key        String    @unique
  label      String
  type       FieldType @default(TEXT)
  unit       String?
  options    String[]
  showPublic Boolean   @default(true)
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────
// Terrains
// ─────────────────────────────────────────────────────────────

enum LotStatus {
  AVAILABLE // disponible à la vente
  RESERVED // réservé (option posée par le responsable)
  SOLD // attribué à un acheteur
  UNAVAILABLE // non commercialisé
}

enum PaymentFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  CUSTOM
}

model Lot {
  id     String    @id @default(cuid())
  number String    @unique
  block  String? // îlot / zone
  areaM2 Float
  price  Float?
  // Prix particulier : ne suit pas le prix du m² du site (Settings.lotPricePerM2)
  customPrice Boolean   @default(false)
  status      LotStatus @default(AVAILABLE)

  // Modalités de paiement proposées
  depositAmount      Float?
  installmentsCount  Int?
  frequency          PaymentFrequency?
  customIntervalDays Int?
  installmentAmount  Float? // montant forcé ; sinon calculé

  // Caractéristiques
  soilType    String?
  position    String?
  orientation String?
  frontageM   Float?
  depthM      Float?
  description String?
  features    String[]
  attributes  Json     @default("{}")
  isFeatured  Boolean  @default(false)

  // Géométrie sur le plan (points normalisés 0..1)
  polygon Json?

  reservedNote String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales                Sale[]
  requests             ReservationRequest[]  @relation("RequestedLot")
  proposedRequests     ReservationRequest[]  @relation("ProposedLot")
  constructionProjects ConstructionProject[]

  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// Acheteurs, ventes, échéances, versements
// ─────────────────────────────────────────────────────────────

model Buyer {
  id            String    @id @default(cuid())
  firstName     String
  lastName      String
  phone         String    @unique // format E.164
  phoneAlt      String?
  email         String?
  address       String?
  city          String?
  country       String?
  profession    String?
  idType        String?
  idNumber      String?
  notes         String?
  portalEnabled Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sales                Sale[]
  requests             ReservationRequest[]
  constructionProjects ConstructionProject[]
}

enum SaleStatus {
  ACTIVE // en cours de paiement
  COMPLETED // soldé
  CANCELLED // annulé / désisté
}

model Sale {
  id        String     @id @default(cuid())
  reference String     @unique
  lotId     String
  buyerId   String
  status    SaleStatus @default(ACTIVE)

  price              Float
  depositAmount      Float            @default(0)
  depositDueDate     DateTime?
  installmentsCount  Int              @default(0)
  frequency          PaymentFrequency @default(MONTHLY)
  customIntervalDays Int?
  firstDueDate       DateTime?

  signedAt     DateTime  @default(now())
  notes        String?
  cancelledAt  DateTime?
  cancelReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lot          Lot                 @relation(fields: [lotId], references: [id])
  buyer        Buyer               @relation(fields: [buyerId], references: [id])
  installments Installment[]
  payments     Payment[]
  documents    Document[]
  request      ReservationRequest?

  @@index([lotId])
  @@index([buyerId])
  @@index([status])
}

model Installment {
  id      String   @id @default(cuid())
  saleId  String
  index   Int // 0 = acompte, 1..n = échéances
  label   String
  dueDate DateTime
  amount  Float

  sale           Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  lastReminderAt DateTime?

  @@unique([saleId, index])
  @@index([dueDate])
}

enum PaymentMethod {
  CASH
  WAVE
  ORANGE_MONEY
  FREE_MONEY
  BANK_TRANSFER
  CHECK
  OTHER
}

model Payment {
  id            String        @id @default(cuid())
  saleId        String
  amount        Float
  paidAt        DateTime
  method        PaymentMethod @default(CASH)
  reference     String?
  note          String?
  receiptNumber String        @unique
  recordedById  String?
  createdAt     DateTime      @default(now())

  sale       Sale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  recordedBy AdminUser? @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([paidAt])
}

// ─────────────────────────────────────────────────────────────
// Demandes de réservation (depuis le site)
// ─────────────────────────────────────────────────────────────

enum RequestStatus {
  NEW // nouvelle demande
  CONTACTED // client contacté
  ALTERNATIVE_PROPOSED // autre terrain proposé
  CONVERTED // transformée en vente
  DECLINED // refusée / sans suite
}

model ReservationRequest {
  id               String        @id @default(cuid())
  lotId            String?
  fullName         String
  phone            String
  email            String?
  message          String?
  preferredContact String        @default("CALL") // CALL | WHATSAPP | EMAIL
  status           RequestStatus @default(NEW)
  adminNotes       String?
  proposedLotId    String?
  buyerId          String?
  saleId           String?       @unique
  handledAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  lot         Lot?   @relation("RequestedLot", fields: [lotId], references: [id], onDelete: SetNull)
  proposedLot Lot?   @relation("ProposedLot", fields: [proposedLotId], references: [id], onDelete: SetNull)
  buyer       Buyer? @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  sale        Sale?  @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// Avancement du site, médias et documents
// ─────────────────────────────────────────────────────────────

enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  DONE
}

model Milestone {
  id          String          @id @default(cuid())
  title       String
  description String?
  progress    Int             @default(0)
  status      MilestoneStatus @default(PLANNED)
  startDate   DateTime?
  endDate     DateTime?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  updates SiteUpdate[]
}

enum Visibility {
  PUBLIC // visible sur le site public
  CLIENTS // réservé aux propriétaires connectés
  PRIVATE // interne (administration uniquement)
}

model SiteUpdate {
  id          String     @id @default(cuid())
  title       String
  body        String
  visibility  Visibility @default(PUBLIC)
  pinned      Boolean    @default(false)
  milestoneId String?
  publishedAt DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  media     Media[]

  @@index([publishedAt])
}

enum MediaType {
  IMAGE
  VIDEO
  EMBED // lien YouTube / Vimeo
}

model Media {
  id         String    @id @default(cuid())
  updateId   String
  type       MediaType
  url        String
  storageKey String?
  mimeType   String?
  size       Int?
  caption    String?
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())

  update SiteUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
}

enum DocumentCategory {
  PLAN
  ADMINISTRATIVE
  CONTRACT
  RECEIPT
  TECHNICAL
  OTHER
  PERMIT // permis de construire, autorisations
  QUOTE // offre, devis
  INVOICE // facture
}

model Document {
  id                    String           @id @default(cuid())
  title                 String
  description           String?
  category              DocumentCategory @default(OTHER)
  visibility            Visibility       @default(CLIENTS)
  saleId                String? // document propre à une vente (visible par l'acheteur concerné)
  // Document d'un projet de construction : visible par son client (CLIENTS) ou interne (PRIVATE)
  constructionProjectId String?
  fromClient            Boolean          @default(false) // déposé par le client depuis son espace
  storageKey            String
  filename              String
  mimeType              String
  size                  Int
  createdAt             DateTime         @default(now())

  sale                Sale?                @relation(fields: [saleId], references: [id], onDelete: Cascade)
  constructionProject ConstructionProject? @relation(fields: [constructionProjectId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([constructionProjectId])
}

// ─────────────────────────────────────────────────────────────
// Authentification client (OTP), journalisation
// ─────────────────────────────────────────────────────────────

model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model SmsLog {
  id        String   @id @default(cuid())
  to        String
  body      String
  kind      String // OTP | PAYMENT | REMINDER | ALERT | MANUAL
  provider  String
  status    String // SENT | FAILED
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Activity {
  id         String   @id @default(cuid())
  type       String
  message    String
  actorId    String?
  entityType String?
  entityId   String?
  createdAt  DateTime @default(now())

  actor AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// Construction : maisons bâties par l'entreprise pour ses clients
// (sur un terrain du lotissement, sur le terrain du client, ou sans terrain au départ)
// ─────────────────────────────────────────────────────────────

enum LandOrigin {
  COMPANY_LOT // terrain du lotissement
  OWN_LAND // terrain du client, situé ailleurs
  NO_LAND // pas encore de terrain
}

enum ConstructionStatus {
  REQUESTED // demande reçue, à étudier
  STUDY // étude : plans et offre en préparation
  OFFER_SENT // offre transmise au client
  SIGNED // offre acceptée, chantier à démarrer
  IN_PROGRESS // chantier en cours
  SUSPENDED // chantier suspendu
  DELIVERED // maison livrée
  CANCELLED // sans suite
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

enum ExpenseScope {
  SITE // lotissement : viabilisation, voirie, frais du site
  PROJECT // chantier d'un client
}

enum ExpenseCategory {
  MATERIALS // matériaux : ciment, fer, agglos, sable…
  LABOR // main-d'œuvre
  EQUIPMENT // matériel, outillage, location d'engins
  TRANSPORT
  SUBCONTRACTING // sous-traitance
  STUDIES // études, plans, géomètre
  PERMITS // permis, taxes, frais administratifs
  UTILITIES // eau, électricité, raccordements
  OTHER
}

// Catalogue des plans proposés aux clients
model HouseModel {
  id           String   @id @default(cuid())
  name         String
  tagline      String   @default("")
  description  String   @default("")
  levels       String? // « Plain-pied », « R+1 »…
  bedrooms     Int?
  bathrooms    Int?
  livingAreaM2 Float?
  minLandM2    Float?
  basePrice    Float? // prix indicatif « à partir de »
  images       Json     @default("[]") // string[]
  features     String[]
  published    Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects ConstructionProject[]
}

model ConstructionProject {
  id        String             @id @default(cuid())
  reference String             @unique
  title     String
  status    ConstructionStatus @default(REQUESTED)
  source    String             @default("ADMIN") // ADMIN | SITE | PORTAL

  // Client : rattaché à un acheteur pour l'accès à l'espace client ; les coordonnées saisies sont conservées
  buyerId      String?
  contactName  String
  contactPhone String
  contactEmail String?

  // Terrain
  landOrigin    LandOrigin
  lotId         String?
  landAddress   String?
  landAreaM2    Float?
  landReference String? // titre foncier, bail, NICAD…

  // Maison
  houseModelId String?
  customPlan   Boolean @default(false)
  requirements String? // besoins exprimés par le client
  budget       Float? // budget indiqué par le client

  // Contrat et calendrier
  contractAmount Float? // montant convenu (offre acceptée)
  startDate      DateTime?
  plannedEndDate DateTime?
  deliveredAt    DateTime?

  showExpensesToClient Boolean   @default(true)
  notes                String?
  cancelledAt          DateTime?
  cancelReason         String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  buyer        Buyer?                    @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  lot          Lot?                      @relation(fields: [lotId], references: [id], onDelete: SetNull)
  houseModel   HouseModel?               @relation(fields: [houseModelId], references: [id], onDelete: SetNull)
  quotes       ConstructionQuote[]
  phases       ConstructionPhase[]
  installments ConstructionInstallment[]
  payments     ConstructionPayment[]
  expenses     Expense[]
  updates      ConstructionUpdate[]
  documents    Document[]

  @@index([status])
  @@index([buyerId])
  @@index([lotId])
}

// Offre de construction (devis détaillé), versionnable
model ConstructionQuote {
  id          String      @id @default(cuid())
  projectId   String
  number      String      @unique
  title       String
  status      QuoteStatus @default(DRAFT)
  items       Json        @default("[]") // { section, label, quantity, unit, unitPrice }[]
  amount      Float       @default(0)
  notes       String?
  validUntil  DateTime?
  sentAt      DateTime?
  respondedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  project ConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// Étapes du chantier ; l'avancement global est la moyenne pondérée par « weight »
model ConstructionPhase {
  id          String          @id @default(cuid())
  projectId   String
  title       String
  description String?
  status      MilestoneStatus @default(PLANNED)
  progress    Int             @default(0)
  weight      Int             @default(1)
  startDate   DateTime?
  endDate     DateTime?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  project  ConstructionProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  expenses Expense[]
  updates  ConstructionUpdate[]

  @@index([projectId])
}

// Appels de fonds (échéancier de paiement de la construction)
model ConstructionInstallment {
  id        String   @id @default(cuid())
  projectId String
  index     Int
  label     String
  dueDate   DateTime
  amount    Float

  project ConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, index])
  @@index([dueDate])
}

// Versements du client pour sa construction
model ConstructionPayment {
  id            String        @id @default(cuid())
  projectId     String
  amount        Float
  paidAt        DateTime
  method        PaymentMethod @default(CASH)
  reference     String?
  note          String?
  receiptNumber String        @unique
  recordedById  String?
  createdAt     DateTime      @default(now())

  project    ConstructionProject @relation(fields: [projectId], references: [id], onDelete: Restrict)
  recordedBy AdminUser?          @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([paidAt])
}

// Dépenses : du lotissement (SITE) ou du chantier d'un client (PROJECT)
model Expense {
  id        String          @id @default(cuid())
  scope     ExpenseScope
  projectId String?
  phaseId   String?
  category  ExpenseCategory @default(MATERIALS)
  label     String
  supplier  String?
  quantity  Float?
  unit      String?
  unitPrice Float?
  amount    Float
  spentAt   DateTime
  method    PaymentMethod?
  reference String? // n° de facture, de bon…
  note      String?

  // Justificatif (facture, reçu) : fichier privé servi par /api/construction/expenses/[id]
  attachmentKey  String?
  attachmentName String?
  attachmentMime String?

  visibleToClient Boolean  @default(true)
  recordedById    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project    ConstructionProject? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  phase      ConstructionPhase?   @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  recordedBy AdminUser?           @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([scope])
  @@index([projectId])
  @@index([spentAt])
}

// Journal de chantier d'un projet (texte + photos / vidéos privées)
model ConstructionUpdate {
  id              String   @id @default(cuid())
  projectId       String
  phaseId         String?
  title           String
  body            String   @default("")
  visibleToClient Boolean  @default(true)
  publishedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project ConstructionProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase   ConstructionPhase?  @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  media   ConstructionMedia[]

  @@index([projectId, publishedAt])
}

model ConstructionMedia {
  id         String    @id @default(cuid())
  updateId   String
  type       MediaType
  storageKey String
  mimeType   String
  size       Int
  caption    String?
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())

  update ConstructionUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)

  @@index([updateId])
}
